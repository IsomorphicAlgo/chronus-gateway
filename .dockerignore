# Build context for `demo/Dockerfile` (repository root). Keeps `docker build` uploads small.
/target
.git
.gitignore
personal.md
logs_*
PLANS.md
*.pdf
.cg-src.tgz
# Demo front ends' Node dependencies and build output (installed locally, never needed in images)
demo/dashboard/node_modules
demo/dashboard/dist
demo/openmct/node_modules
demo/openmct/dist
# cargo-fuzz build output and corpora (Tranche 5; never needed in images)
fuzz/target
fuzz/corpus
fuzz/artifacts
fuzz/seeds
