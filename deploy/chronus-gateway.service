# systemd unit for a native install (Tranche 4, docs/DEPLOYMENT.md).
#
#   sudo install -m 0755 chronus-gateway /usr/local/bin/
#   sudo install -m 0644 deploy/chronus.sysusers /usr/lib/sysusers.d/chronus.conf && sudo systemd-sysusers
#   sudo install -d -m 0750 /etc/chronus
#   sudo install -m 0640 deploy/gateway.production.toml /etc/chronus/gateway.toml   # then edit it
#   chronus-gateway --generate-token | sudo tee /etc/chronus/api_tokens >/dev/null
#   sudo chmod 0600 /etc/chronus/api_tokens
#   sudo install -m 0644 deploy/chronus-gateway.service /etc/systemd/system/
#   sudo install -m 0755 deploy/fetch-data.sh /usr/local/bin/chronus-fetch-data
#   sudo install -m 0644 deploy/chronus-fetch-data.service deploy/chronus-fetch-data.timer /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl start chronus-fetch-data.service        # first download: the TLE file must exist
#   sudo systemctl enable --now chronus-fetch-data.timer chronus-gateway

[Unit]
Description=ChronusGateway-RS CCSDS telemetry gateway
Documentation=https://github.com/IsomorphicAlgo/chronus-gateway/blob/master/docs/DEPLOYMENT.md
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
User=chronus
Group=chronus
# Refuse to start on a bad config, with the plain-English explanation in the journal.
ExecStartPre=/usr/local/bin/chronus-gateway --check-config --config /etc/chronus/gateway.toml
ExecStart=/usr/local/bin/chronus-gateway --config /etc/chronus/gateway.toml --log-format json
Restart=on-failure
RestartSec=5s
# SIGTERM: the gateway flushes the history file and exits.
TimeoutStopSec=15s
Environment=RUST_LOG=info

# Tokens are handed over as a credential: readable by this service only, never in the config.
LoadCredential=api_tokens:/etc/chronus/api_tokens
# /var/lib/chronus-gateway: history file, TLE and Earth orientation data.
StateDirectory=chronus-gateway
StateDirectoryMode=0750
UMask=0077

# Hardening (`systemd-analyze security chronus-gateway` scores this unit).
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
